<?xml version="1.0" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/selected_panel"/>
            <stroke android:width="1dp" android:color="@color/selected_border"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel"/>
            <stroke android:width="1dp" android:color="@color/border"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
