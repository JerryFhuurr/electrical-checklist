<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/page_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/model_eyebrow" style="@style/Eyebrow"/>
        <TextView android:id="@+id/model_title" style="@style/PageTitle"/>
        <TextView style="@style/BodyText" android:text="@string/choose_phase"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel_background">
            <TextView android:id="@+id/model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/accent"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/checklists_complete" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/model_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="18dp" android:progressTint="@color/accent" android:progressBackgroundTint="@color/border"/>
        </LinearLayout>
        <TextView style="@style/Eyebrow" android:layout_marginTop="24dp" android:text="@string/flight_phases"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/view_checklist_button" style="@style/PrimaryAction" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:text="@string/view_checklist"/>
        <LinearLayout android:id="@+id/phase_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/source_button" style="@style/TextAction" android:layout_marginTop="18dp" android:text="@string/source_notes"/>
    </LinearLayout>
</ScrollView>
