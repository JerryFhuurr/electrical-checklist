<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/page_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Eyebrow" android:text="@string/aircraft_library"/>
        <TextView android:id="@+id/aircraft_title" style="@style/PageTitle"/>
        <TextView style="@style/BodyText" android:text="@string/choose_aircraft"/>
        <LinearLayout android:id="@+id/aircraft_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView style="@style/Eyebrow" android:layout_marginTop="28dp" android:text="@string/simple_routine"/>
        <TextView style="@style/BodyText" android:text="@string/routine"/>
        <TextView style="@style/BodyText" android:layout_marginTop="28dp" android:text="@string/autosaved"/>
    </LinearLayout>
</ScrollView>
