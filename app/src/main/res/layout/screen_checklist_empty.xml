<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page_scroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center" android:padding="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/select_checklist"
            android:textSize="24sp" android:textStyle="bold" android:textColor="@color/ink" android:gravity="center" android:accessibilityHeading="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/select_checklist_hint" android:textSize="14sp" android:textColor="@color/muted" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
