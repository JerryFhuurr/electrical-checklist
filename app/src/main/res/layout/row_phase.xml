<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel_background" android:foreground="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/phase_number" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/muted"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/phase_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/ink"/>
            <TextView android:id="@+id/phase_description" style="@style/BodyText" android:layout_marginTop="4dp" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forward_symbol" android:textSize="26sp" android:textColor="@color/muted" android:importantForAccessibility="no"/>
    </LinearLayout>
    <TextView android:id="@+id/phase_status" style="@style/BodyText" android:layout_marginTop="16dp" android:textSize="12sp"/>
</LinearLayout>
