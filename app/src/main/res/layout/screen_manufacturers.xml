<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Eyebrow" android:text="@string/flight_companion"/>
        <TextView style="@style/PageTitle" android:text="@string/home_title"/>
        <TextView style="@style/BodyText" android:text="@string/choose_manufacturer"/>
        <TextView style="@style/Eyebrow" android:layout_marginTop="28dp" android:text="@string/manufacturers_title"/>
        <LinearLayout android:id="@+id/manufacturer_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView style="@style/BodyText" android:layout_marginTop="28dp" android:text="@string/autosaved"/>
    </LinearLayout>
</ScrollView>
