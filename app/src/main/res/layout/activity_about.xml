<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/about_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <TextView android:id="@+id/about_back" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/back_symbol" android:textSize="32sp" android:textColor="@color/ink" android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:contentDescription="@string/back_to_settings"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/about" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" android:accessibilityHeading="true" android:paddingHorizontal="12dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView style="@style/PageTitle" android:text="@string/app_name"/>
            <TextView android:id="@+id/about_version" style="@style/BodyText"/>
            <TextView style="@style/BodyText" android:text="@string/about_description"/>
            <TextView style="@style/Eyebrow" android:layout_marginTop="32dp" android:text="@string/updates_heading"/>
            <TextView style="@style/BodyText" android:text="@string/update_settings_hint"/>
            <TextView android:id="@+id/update_status" style="@style/BodyText" android:accessibilityLiveRegion="polite"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/check_updates_button" style="@style/PrimaryAction" android:text="@string/check_updates" android:layout_marginTop="16dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/app_network_settings_button" style="@style/TextAction" android:text="@string/app_network_settings" android:visibility="gone"/>
            <TextView style="@style/Eyebrow" android:layout_marginTop="32dp" android:text="@string/author_label"/>
            <TextView android:id="@+id/about_author" style="@style/BodyText" android:text="@string/author_name" android:textIsSelectable="true"/>
            <TextView style="@style/Eyebrow" android:layout_marginTop="32dp" android:text="@string/source_code"/>
            <TextView style="@style/BodyText" android:text="@string/github_url" android:textIsSelectable="true"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/github_button" style="@style/PrimaryAction" android:text="@string/open_github" android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
